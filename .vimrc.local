"soruby
"colorscheme soruby
colorscheme onedark
set guifont=Menlo:h18

set encoding=utf-8
set termencoding=utf-8
set fileencoding=utf-8
set fileencodings=UCS-bom,utf-8,gb18030,gbk,latin1

set ignorecase
set smartcase
set nospell
set nrformats=bin
set relativenumber
set lazyredraw

language messages zh_CN.utf-8

au BufNewFile,BufRead *.groovy  setf groovy

" let mapleader = "\<Space>"
" let g:mapleader = "\<Space>"
" let g:C_MapLeader="\<Space>"

if has("gui_running")
    "windows剪切板设为默认寄存器
    set clipboard+=unnamed

    "添加水平滚动条
    set guioptions+=b
endif

"自动保存文件
"set autowriteall

"hi cursorline guifg=magenta cyan orange purple violet seagreen slateblue darkred

"json文件格式化
nnoremap <unique><silent> <localleader>jf :call FormatJson()<cr>
"xml文件格式化，需要libxml2支持，在百度云盘中有
nnoremap <unique><silent> <localleader>xf :call FormatXml()<cr>
nnoremap <unique><silent> <localleader>xi :%!xmllint --encode utf8 --pretty 1 --recover - 2>/dev/null<cr>
vnoremap <unique><silent> <localleader>xi :!xmllint --encode utf8 --pretty 1 --recover - 2>/dev/null<cr>
vnoremap <unique><silent> <localleader>fp :call FormatPrivate()<cr>
nnoremap <unique><silent> <localleader>fp :call FormatPrivate()<cr>
vnoremap <unique><silent> <localleader>fr :call FormatResponse()<cr>
vnoremap <unique><silent> <localleader>fm :call FormatMapper()<cr>
vnoremap <unique><silent> <localleader>fw :call DelChineseWidth()<cr>

" :help indent-guides
nmap <silent> <Leader>ig <Plug>IndentGuidesToggle
nmap <silent> <Leader>ie <Plug>IndentGuidesEnable
nmap <silent> <Leader>id <Plug>IndentGuidesDisable

